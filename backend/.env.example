# Application Config
APP_NAME=WhatsApp Fashion AI
APP_ENV=development
DEBUG=True
PORT=8000
SECRET_KEY=change-this-to-a-super-secret-key-32-chars-min
STOREFRONT_URL=https://ai-whatsapp-power-git-main-hamzachaudhary786s-projects.vercel.app

# MongoDB Database Config
DATABASE_URL=mongodb://localhost:27017/whatsapp_fashion_db
MONGODB_DB_NAME=whatsapp_fashion_db

# Redis
REDIS_URL=redis://localhost:6379/0

# WhatsApp Cloud API
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# AI / LLM Integration (OpenAI or Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
